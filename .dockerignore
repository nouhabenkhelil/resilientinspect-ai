# Backend build context: an allowlist, never datasets, runs or local secrets.
**
!pyproject.toml
!README.md
!src/
!src/**/
!src/**/*.py
!backend/
!backend/__init__.py
!backend/requirements.txt
!backend/requirements-cpu.txt
!backend/requirements-onnx.txt
!backend/app/
!backend/app/*.py
!deployment/
!deployment/healthcheck.py
!deployment/__init__.py
!deployment/validate_portability.py
**/__pycache__/
**/*.pyc
**/*.pt
**/*.pth
**/*.ckpt
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.tif
**/*.tiff
**/*.webp
**/.env*
