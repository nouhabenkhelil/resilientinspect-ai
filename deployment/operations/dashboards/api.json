{
  "uid": "ri-api",
  "title": "02 \u00b7 Requ\u00eates API",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "resilientinspect",
    "real-measurements"
  ],
  "panels": [
    {
      "id": 1,
      "title": "D\u00e9bit HTTP mesur\u00e9",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(ri_http_requests_total[5m]))",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Ratio 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ri_http_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(ri_http_requests_total[5m]))",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Latence p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(ri_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}