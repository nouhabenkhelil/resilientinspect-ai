{
  "uid": "ri-batches",
  "title": "03 \u00b7 Surveillance des lots",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "resilientinspect",
    "real-measurements"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Images en attente",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ri_batch_pending",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Images en cours",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ri_batch_running",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "\u00c2ge de la file",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ri-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ri_batch_oldest_pending_seconds",
          "legendFormat": "{{__name__}} {{engine}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}